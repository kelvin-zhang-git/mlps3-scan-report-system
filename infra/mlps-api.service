[Unit]
Description=等保三级扫描与报告系统 API
After=network.target docker.service

[Service]
WorkingDirectory=/opt/mlps/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/mlps/.env
ExecStart=/opt/mlps/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 18000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
